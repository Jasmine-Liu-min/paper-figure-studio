# ============ 论文配图工作台 · 环境变量示例 ============
# 用法：复制本文件为 .env.local，填入你的 key。
# .env.local 已被 .gitignore 忽略，不会提交到仓库（key 只留在本地）。

# ---------- ① 文本规划（必填，驱动导图 / 架构图 / 图表代码三条链路）----------
# 选一个文本 provider：
LLM_PROVIDER=mock        # gateway | openai | gemini | openrouter | cloudflare | custom | mock

# 方式 A：OpenAI 兼容网关（学校 / 公司 / 自建，推荐）—— 地址和 key 找提供网关的人要
GATEWAY_BASE_URL=        # 网关地址，OpenAI 兼容（代码会自动补 /v1）
GATEWAY_API_KEY=
GATEWAY_TEXT_MODEL=gpt-5.5

# 方式 B：OpenAI 官方   key → https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.5

# 方式 C：Google Gemini  key → https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash

# 方式 D：OpenRouter（一个 key 调多家）key → https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemini-2.0-flash-exp:free

# 方式 E：Cloudflare Workers AI  → https://dash.cloudflare.com （AI 菜单建 API Token；账号 ID 在控制台右栏）
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast

# 方式 F：任意 OpenAI 兼容的自定义文本接口（★没有网关的人推荐用这个★）
#   · 智谱 GLM-4-Flash（国内/免费）：BASE=https://open.bigmodel.cn/api/paas/v4/chat/completions  MODEL=glm-4-flash  key→https://bigmodel.cn
#   · 阿里云百炼 Qwen（国内）：     BASE=https://dashscope.aliyuncs.com/compatible-mode/v1       MODEL=qwen-plus    key→百炼 API-KEY(sk-)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_TEXT_MODEL=gpt-4o-mini
CUSTOM_LLM_WIRE_API=chat        # chat | responses

# LLM_TIMEOUT_MS=90000          # 复杂论文出图较慢，默认 90s，勿调太小（太小会退回模板）

# ---------- ② PDF 解析（可选；不填则上传 PDF 自动走本地 pdfjs 兜底）----------
# MinerU 云 API：免费 2000 页/天，中文 + 学术论文最准。
# 申请 Token（eyJ 开头的长 JWT，14 天有效）→ https://mineru.net/apiManage
MINERU_API_KEY=
# MINERU_ENDPOINT=              # 私有化部署填 http://你的IP:端口；留空=走官方云

# ---------- ③ AI 配图（可选；UI 默认关闭，启用见 README「如何接入 AI 配图」）----------
IMAGE_PROVIDER=mock      # qwen | custom-image | gemini | openai | openrouter | replicate | stability | pollinations | mock

# 阿里云百炼 Qwen-Image（国内、中文标签最强）
# 1) 开通百炼并拿 API-KEY（sk- 开头）→ https://bailian.console.aliyun.com → 右上角「API-KEY」
# 2) 去「模型广场」开通对应模型的 API 权限，否则报 Model.AccessDenied
DASHSCOPE_API_KEY=
QWEN_IMAGE_MODEL=qwen-image-2.0                 # 同步:qwen-image-2.0/-pro/-max；异步:qwen-image/-plus/wanx*
QWEN_BASE_URL=https://dashscope.aliyuncs.com    # 新加坡地域改 https://dashscope-intl.aliyuncs.com

# 智谱 CogView（免费免绑卡，OpenAI 兼容）key → https://bigmodel.cn 控制台 → API Keys
# 用法：IMAGE_PROVIDER=custom-image
CUSTOM_IMAGE_BASE_URL=          # 如 https://open.bigmodel.cn/api/paas/v4/images/generations
CUSTOM_IMAGE_API_KEY=
CUSTOM_IMAGE_MODEL=gpt-image-1
CUSTOM_IMAGE_MODE=auto          # auto | images | chat | responses
# CUSTOM_IMAGE_SIZE=            # 某些模型只认固定尺寸时填，如 1344x768

# 其它图片 provider（按需）：
# OpenAI 图片   key 同上 platform.openai.com
OPENAI_IMAGE_MODEL=gpt-image-1
# Gemini 图片（需开通 billing）key 同上 aistudio.google.com
GEMINI_IMAGE_MODEL=gemini-3-pro-image
# OpenRouter 图片  key 同上 openrouter.ai
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview
# Replicate   token → https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
# Stability   key → https://platform.stability.ai/account/keys
STABILITY_API_KEY=
STABILITY_IMAGE_MODEL=stable-image-core
STABILITY_IMAGE_ENDPOINT=https://api.stability.ai/v2beta/stable-image/generate/core
# Pollinations（免 key 免费，文字弱）
POLLINATIONS_IMAGE_MODEL=flux
# 网关出图（若你的网关支持图片接口）
IMAGE_GATEWAY_BASE_URL=
IMAGE_GATEWAY_API_KEY=
GATEWAY_IMAGE_MODEL=gpt-image-1
IMAGE_GATEWAY_MODEL=gpt-image-1
GATEWAY_IMAGE_MODE=auto
